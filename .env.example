# Spotify app credentials (https://developer.spotify.com/dashboard)
# Copy this file to .env and fill in the real values. Never commit .env.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI registered in the app settings
# on developer.spotify.com/dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Playlist ID or full URL (can also be passed as a CLI argument instead)
# Example: PLAYLIST_ID=37i9dQZF1DXcBWIGoYBM5M
PLAYLIST_ID=

# Gemini API key for constellation naming
# (free, no card needed: aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here
